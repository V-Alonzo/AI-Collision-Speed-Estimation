-- =============================================================================
-- 4. INCIDENTE  [UUID v1.3]
-- =============================================================================
-- uuid: clave pública expuesta en URLs y API (GET /incidentes/{uuid}).
-- id:   clave interna usada en JOINs con tablas hijas.
-- La pantalla "Expedientes RAT" muestra: No.Siniestro, fecha, hora,
-- tipo de hecho, vehículo (marca+modelo+año), perito, estado, vel calculada,
-- exceso de velocidad. Todo esto se construye con JOINs desde aquí.
-- id_usuario_perito → sys_users.id_user

CREATE TABLE RAT_INCIDENTE (
  id                 BIGINT       NOT NULL AUTO_INCREMENT,
  uuid               CHAR(36)     NOT NULL COMMENT 'UUID público — usar en URLs y API',
  numero_siniestro   VARCHAR(100) NOT NULL COMMENT 'Ej: RAT-2026-024',
  fecha_hecho        DATE         NOT NULL,
  hora_hecho         TIME         NULL,
  tipo_hecho_id      INT          NOT NULL COMMENT 'FK → RAT_CAT_TIPO_HECHO.id',
  id_usuario_perito  INT          NOT NULL COMMENT 'FK → sys_users.id_user',
  estado             TINYINT      NOT NULL DEFAULT 0
                       COMMENT '0=Abierto / 1=En revisión / 2=Finalizado',
  created_at         DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at         DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT pk_incidente          PRIMARY KEY (id),
  CONSTRAINT uq_incidente_uuid     UNIQUE (uuid),
  CONSTRAINT uq_incidente_num      UNIQUE (numero_siniestro),
  CONSTRAINT fk_inc_tipo_hecho     FOREIGN KEY (tipo_hecho_id)     REFERENCES RAT_CAT_TIPO_HECHO(id),
  CONSTRAINT fk_inc_perito         FOREIGN KEY (id_usuario_perito) REFERENCES sys_users(id_user),
  CONSTRAINT chk_inc_estado        CHECK (estado IN (0, 1, 2))
) ENGINE=InnoDB COMMENT='Expediente RAT. estado: 0=Abierto, 1=En revisión, 2=Finalizado';

-- =============================================================================
-- 5. UBICACIÓN DE LA VÍA  [UUID v1.3]
-- =============================================================================
-- uuid: clave pública. incidente_id: FK interna al BIGINT de RAT_INCIDENTE.
-- Corrección v4: se eliminaron campos que no corresponden a la ubicación:
--   ✗ estado_neumatico_id  → movido a RAT_TABLA_MU (lookup técnico)
-- Se mantienen únicamente características físicas y ambientales de la vía.

CREATE TABLE RAT_UBICACION_VIA (
  id                             BIGINT        NOT NULL AUTO_INCREMENT,
  uuid                           CHAR(36)      NOT NULL COMMENT 'UUID público — usar en URLs y API',
  incidente_id                   BIGINT        NOT NULL,
  -- Dirección
  calle                          VARCHAR(200)  NULL,
  numero_exterior                VARCHAR(20)   NULL,
  colonia                        VARCHAR(100)  NULL,
  codigo_postal                  VARCHAR(10)   NULL,
  municipio                      VARCHAR(100)  NULL,
  estado_republica               VARCHAR(100)  NULL,
  pais                           VARCHAR(100)  NOT NULL DEFAULT 'México',
  referencia_adicional           TEXT          NULL,
  km_punto                       VARCHAR(50)   NULL     COMMENT 'Ej: Km 93+500',
  lat                            DECIMAL(10,7) NULL,
  lng                            DECIMAL(10,7) NULL,
  -- Características de la vía
  velocidad_maxima_permitida_kmh INT           NULL,
  tipo_via_id                    INT           NULL     COMMENT 'FK → RAT_CAT_TIPO_VIA.id',
  tipo_trazo_id                  INT           NULL,
  tipo_interseccion_id           INT           NULL,
  senalamiento_vertical_id       INT           NULL,
  senalamiento_horizontal_id     INT           NULL,
  medidas_via_m                  DECIMAL(6,2)  NULL     COMMENT 'Ancho de la vía en metros',
  orientacion_id                 INT           NULL,
  sentido_vialidad_id            INT           NULL,
  -- Condiciones al momento del hecho
  condicion_superficie_id        INT           NULL,
  condicion_pavimento_id         INT           NULL,
  tipo_pavimento_id              INT           NULL,
  clima_id                       INT           NULL,
  -- Coeficientes para cálculo (se derivan de TABLA_MU pero se guardan aquí)
  mu_coeficiente_adherencia      DECIMAL(5,4)  NULL     COMMENT 'Lookup RAT_TABLA_MU',
  inclinacion_pct                DECIMAL(6,3)  NULL     COMMENT '+ rampa / − pendiente',
  mu_corregido                   DECIMAL(5,4)  NULL     COMMENT 'CALCULADO: mu ± inclinacion/100',
  radio_curva_m                  DECIMAL(8,2)  NULL     COMMENT 'Para velocidad de derrape/vuelco',
  peraltaje_pct                  DECIMAL(6,3)  NULL     COMMENT 'Para velocidad de derrape',
  CONSTRAINT pk_ubicacion           PRIMARY KEY (id),
  CONSTRAINT uq_ubicacion_uuid      UNIQUE (uuid),
  CONSTRAINT uq_ubic_incidente      UNIQUE (incidente_id),
  CONSTRAINT fk_ubic_incidente      FOREIGN KEY (incidente_id)               REFERENCES RAT_INCIDENTE(id),
  CONSTRAINT fk_ubic_tipo_via       FOREIGN KEY (tipo_via_id)                REFERENCES RAT_CAT_TIPO_VIA(id),
  CONSTRAINT fk_ubic_trazo          FOREIGN KEY (tipo_trazo_id)              REFERENCES RAT_CAT_TIPO_TRAZO(id),
