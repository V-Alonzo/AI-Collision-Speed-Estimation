-- =============================================================================
-- CESVI MÉXICO — Base de Datos de Peritaje y Análisis Forense de Tránsito
-- Versión 1.3 | Marzo 2026
-- =============================================================================
-- CAMBIOS v1.3 (respecto a v1.2):
--   • UUID añadido como PK pública en las tablas expuestas al usuario:
--       RAT_INCIDENTE, RAT_REPORTE, RAT_VEHICULO,
--       RAT_INCIDENTE_VEHICULO, RAT_UBICACION_VIA
--   • Estrategia: id BIGINT AUTO_INCREMENT se conserva como PK interna
--     para eficiencia en JOINs; uuid CHAR(36) NOT NULL UNIQUE es la clave
--     que se expone en URLs y respuestas de API.
--   • Las FKs entre tablas internas siguen usando el BIGINT id.
--   • Catálogos (RAT_CAT_*), tablas técnicas (RAT_TABLA_*) y plantillas
--     (RAT_PLANTILLA_*) NO llevan UUID: son datos internos de lookup.
-- =============================================================================
-- NOTAS DE INTEGRACIÓN:
--   • Esta BD coexiste con el sistema base (dynamic template) de Cesvi.
--   • NO se crea tabla USUARIO: se referencia sys_users.id_user mediante FK.
--   • Se crean RAT_CAT_TIPO_HECHO y RAT_CAT_TIPO_VIA como catálogos propios
--     del módulo RAT (no existen en la plataforma base).
--   • Se crea RAT_PERITO_PERFIL para extender sys_users con datos del perito.
--   • Los catálogos restantes son propios del módulo RAT (no existen en base).
-- =============================================================================

SET FOREIGN_KEY_CHECKS = 0;
SET NAMES utf8mb4;

-- Asegurarse de usar la BD correcta
USE cesvi_db;

-- =============================================================================
-- 1. EXTENSIÓN DE USUARIO — Perfil del perito
-- =============================================================================
-- Extiende sys_users (de la plataforma base) con datos específicos del perito.
-- La pantalla "Mi Perfil" muestra: teléfono, cédula profesional, especialidad,
-- número de empleado, calificación y fecha de alta.

CREATE TABLE RAT_PERITO_PERFIL (
  id_user           INT           NOT NULL  COMMENT 'FK → sys_users.id_user (1:1)',
  telefono          VARCHAR(20)   NULL,
  cedula_profesional VARCHAR(30)  NULL,
  especialidad      VARCHAR(200)  NULL      COMMENT 'Ej: Reconstrucción de Accidentes Viales',
  numero_empleado   VARCHAR(30)   NULL      COMMENT 'Ej: CESVI-MX-1048',
  calificacion      DECIMAL(3,1)  NULL      COMMENT 'Rating 0.0 – 5.0',
  fecha_alta        DATE          NULL,
  CONSTRAINT pk_perito_perfil  PRIMARY KEY (id_user),
  CONSTRAINT fk_perfil_sysuser FOREIGN KEY (id_user) REFERENCES sys_users(id_user)
) ENGINE=InnoDB COMMENT='Extiende sys_users con datos propios del perito RAT';

